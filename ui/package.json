{
  "name": "ferry-ui",
  "version": "0.0.0",
  "description": "ferry's interface, embedded into the ferry binary.",
  "private": true,
  "scripts": {
    "ng": "ng",
    "generate": "openapi-typescript ../api/openapi/ferry-v1.yaml -o src/app/core/schema.ts --default-non-nullable=false",
    "start": "npm run generate && ng serve",
    "start:de": "npm run generate && ng serve --configuration development-de",
    "build": "npm run generate && ng build",
    "test": "npm run generate && ng test",
    "lint": "prettier --check src",
    "format": "prettier --write src",
    "extract-i18n": "npm run generate && ng extract-i18n"
  },
  "packageManager": "npm@11.19.1",
  "dependencies": {
    "@angular/cdk": "^22.3.0",
    "@angular/common": "^22.3.0",
    "@angular/compiler": "^22.3.0",
    "@angular/core": "^22.3.0",
    "@angular/forms": "^22.3.0",
    "@angular/localize": "^22.3.0",
    "@angular/platform-browser": "^22.3.0",
    "@angular/router": "^22.3.0",
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@fontsource-variable/fraunces": "^5.3.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.3.0",
    "@angular/cli": "^22.3.0",
    "@angular/compiler-cli": "^22.3.0",
    "jsdom": "^31.0.0",
    "openapi-typescript": "^7.13.0",
    "prettier": "^3.10.0",
    "typescript": "~6.0.2",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": ">=22.22.3"
  },
  "overrides": {
    "openapi-typescript": {
      "typescript": "$typescript"
    }
  }
}
