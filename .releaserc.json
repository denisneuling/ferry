{
  "branches": ["main"],
  "plugins": [
    ["@semantic-release/commit-analyzer", { "releaseRules": [{ "breaking": true, "release": "minor" }] }],
    "@semantic-release/release-notes-generator",
    ["@semantic-release/changelog", { "changelogFile": "CHANGELOG.md" }],
    [
      "@semantic-release/exec",
      {
        "successCmd": "sh .forgejo/trigger-release.sh ${nextRelease.gitTag}"
      }
    ],
    ["@semantic-release/git", { "assets": ["CHANGELOG.md"], "message": "chore: release v${nextRelease.version}" }]
  ]
}
